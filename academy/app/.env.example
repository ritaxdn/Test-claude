# Base de données Postgres (Supabase, Neon…). Obligatoire.
DATABASE_URL=postgres://user:password@host:5432/academy

# Adresse publique de l'Academy (liens d'invitation, e-mails).
APP_URL=https://academy.cellulift.ma

# Vidéo : "local" (développement : fichiers dans private-media/videos) ou "mux" (production, DRM).
VIDEO_PROVIDER=local
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY_BASE64=
MUX_DRM_ENABLED=false

# Documents : "local" (private-media/docs) ou "supabase" (Supabase Storage, bucket privé).
STORAGE_PROVIDER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=academy-documents

# E-mails d'invitation (Resend). Sans clé, rien n'est envoyé : l'admin copie le lien.
RESEND_API_KEY=
MAIL_FROM="CELLULIFT Academy <academy@cellulift.ma>"
