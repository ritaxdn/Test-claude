{
  "name": "cellulift-academy-video",
  "version": "0.1.0",
  "private": true,
  "description": "Vidéo publicitaire animée de CELLULIFT Academy (Remotion). Indépendante de academy/app.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "stills": "node scripts/stills.mjs",
    "render:16x9": "remotion render src/index.ts Pub16x9 out/academy-pub-16x9.mp4",
    "render:9x16": "remotion render src/index.ts Pub9x16 out/academy-pub-9x16.mp4",
    "render": "npm run render:16x9 && npm run render:9x16",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.2.8",
    "@fontsource/cormorant-garamond": "5.2.11",
    "@fontsource/instrument-sans": "5.2.8",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@remotion/bundler": "4.0.399",
    "@remotion/cli": "4.0.399",
    "@remotion/renderer": "4.0.399",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "4.0.399"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "typescript": "5.9.3"
  }
}
