# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Only the public URL and the anon / publishable key are needed.
# NEVER put the service_role key in this app or in any NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public base URL, used for email confirmation redirects (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
